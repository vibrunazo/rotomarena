# =====================================================================
# RotomArena Environment Configuration
# =====================================================================

# OpenRouter (default provider; the default model is free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Local llama.cpp server (Smooth Generator `gen llm serve`)
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=bonsai

# Google Gemini (paid; via Google AI Studio OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Ollama / vLLM (vLLM moved off its default port 8000, which Showdown uses)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3:70b
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
