# =====================================================================
# RotomArena Environment Configuration
# =====================================================================

# Showdown Server Settings
SHOWDOWN_HOST=localhost
SHOWDOWN_PORT=8000
SHOWDOWN_NO_SECURITY=true

# Google Gemini (via Google AI Studio OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Local Ollama / vLLM
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.3:70b

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Default output directory for replays and logs
ROTOMARENA_OUTPUT_DIR=./runs
