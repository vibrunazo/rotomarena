---
// The Showdown replay player, fed the raw battle log. Ported from telemetry/replay_saver.py.
interface Props { log: string[]; brought?: Record<string, string[]> }
const { log, brought = {} } = Astro.props;
// Showdown's convention for a log inlined in <script>: every "/" becomes "\/", so the log can never contain
// "</script>"; replay-embed.js turns them back.
const logText = log.join('\n').replaceAll('/', '\\/');
---
<div class="replay-scroll">
  <div class="wrapper replay-wrapper">
    <div class="battle"></div>
    <div class="battle-log"></div>
    <div class="replay-controls"></div>
    <div class="replay-controls-2"></div>
  </div>
</div>
<p class="small muted noscript-note">The replay player loads from play.pokemonshowdown.com. The full battle log is below.</p>

<script is:inline>
  // Showdown's Config routes must exist before replay-embed.js runs, or its effect sprites resolve to this site.
  window.Config = window.Config || {};
  window.Config.routes = {
    root: 'pokemonshowdown.com',
    client: 'play.pokemonshowdown.com',
    dex: 'dex.pokemonshowdown.com',
    replays: 'replay.pokemonshowdown.com',
  };
  // Effect images (Stealth Rock, Spikes, Sticky Web) still ask for relative paths; send them to Showdown's fx CDN.
  document.addEventListener('error', function (e) {
    var img = e.target;
    if (!img || img.tagName !== 'IMG' || img.dataset.retried) return;
    img.dataset.retried = 'true';
    var file = (img.getAttribute('src') || '').split('/').pop().split('?')[0];
    if (file && file.endsWith('.png')) img.src = 'https://play.pokemonshowdown.com/fx/' + file;
  }, true);
  (function () {
    var fxBase = 'https://play.pokemonshowdown.com/fx/';
    function fix() {
      if (window.Dex) {
        if (!String(window.Dex.fxPrefix || '').startsWith('http')) window.Dex.fxPrefix = fxBase;
        if (!String(window.Dex.resourcePrefix || '').startsWith('http')) window.Dex.resourcePrefix = 'https://play.pokemonshowdown.com/';
      }
      if (window.BattleEffects) {
        for (var id in window.BattleEffects) {
          var fx = window.BattleEffects[id];
          if (fx && fx.url && !fx.url.startsWith('http') && !fx.url.startsWith('//')) {
            fx.url = fxBase + fx.url.replace(/^\/?(fx\/)?/, '');
          }
        }
      }
    }
    var timer = setInterval(fix, 50);
    window.addEventListener('load', function () { fix(); setTimeout(function () { clearInterval(timer); }, 10000); });
  })();
</script>
<script is:inline type="text/plain" class="battle-log-data" set:html={logText} />
<script is:inline src="https://play.pokemonshowdown.com/js/replay-embed.js"></script>
<script is:inline define:vars={{ brought }}>
  // Ring the Pokémon each player brought (bring-N formats). Showdown keeps the picks hidden until each switches
  // in, so they come from our own records: {username: [species ids, the lead first]}.
  window.markBrought = function (picks) {
    function id(s) { return String(s || '').toLowerCase().replace(/\s*\(.*$/, '').replace(/[^a-z0-9]/g, ''); }
    function apply() {
      document.querySelectorAll('.battle .trainer').forEach(function (trainer) {
        var name = ((trainer.querySelector('strong') || {}).textContent || '').trim();
        var ids = picks[name] || [];
        trainer.querySelectorAll('.picon').forEach(function (icon) {
          var label = id(icon.getAttribute('aria-label') || icon.title);
          // a base name before the forme is revealed (Rotom for Rotom-Wash), a longer one after Mega Evolving
          var brought = !!label && ids.some(function (x) { return x.indexOf(label) === 0 || label.indexOf(x) === 0; });
          if (icon.classList.contains('brought') !== brought) icon.classList.toggle('brought', brought);
        });
      });
    }
    apply();
    var battle = document.querySelector('.battle');
    if (battle && !battle.dataset.ringed) {
      battle.dataset.ringed = '1';
      new MutationObserver(function () { window.markBrought.refresh(); }).observe(battle, {childList: true, subtree: true});
    }
    window.markBrought.refresh = apply;
  };
  var ring = setInterval(function () {
    if (document.querySelector('.battle .trainer')) { clearInterval(ring); window.markBrought(brought); }
  }, 300);
</script>
<script is:inline>
  // The site is dark only. Showdown picks its theme from the system scheme (body.dark) and resets it when the
  // scheme changes, so pin its dark theme after it does.
  (function () {
    function pin() { document.body.classList.add('dark'); }
    pin();
    window.addEventListener('load', pin);
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () { setTimeout(pin); });
  })();
</script>

<style>
  .replay-scroll { overflow-x: auto; margin: 1rem 0; }
  .replay-wrapper { min-width: 640px; max-width: 1180px; margin: 0 auto; font-family: var(--font-body); }
  .noscript-note { margin-top: 0; }
  :global(.battle) :global(.picon.brought) { border-radius: 50%; box-shadow: 0 0 0 2px #f6c945; opacity: 1 !important; }
</style>
