---
// A table of matches linking to their replay pages. Each game reads "Winner > Loser".
import { routes } from '../lib/routes';
import { fmtDate, fmtDuration, winner, type MatchEntry } from '../lib/data';

interface Props { matches: MatchEntry[]; retracted?: boolean; showReason?: boolean }
const { matches, retracted = false, showReason = false } = Astro.props;
const href = retracted ? routes.retractedMatch : routes.match;
---
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Date</th>
        <th>Game (winner first)</th>
        <th class="r">Turns</th>
        <th class="r">Duration</th>
        {showReason && <th>Grounds</th>}
        <th></th>
      </tr>
    </thead>
    <tbody>
      {matches.map(({ slug, data: m }) => {
        const [p1, p2] = m.players;
        const w = winner(m);
        return (
          <tr>
            <td class="num">{fmtDate(m.date)}</td>
            <td>
              {w
                ? <><strong>{w.display_name}</strong><span class="beat" aria-label="beat">&gt;</span>{(w === p1 ? p2 : p1)?.display_name}</>
                : <>{p1?.display_name}<span class="vs muted">vs</span>{p2?.display_name} <span class="muted small">(draw)</span></>}
              {!retracted && m.void_reason && <span class="pill bad" title={m.void_reason}>void</span>}
            </td>
            <td class="r num">{m.turns}</td>
            <td class="r num">{fmtDuration(m.duration_seconds)}</td>
            {showReason && <td class="small muted reason">{m.void_reason ?? 'pilot ruleset'}</td>}
            <td><a href={href(slug)}>Replay</a></td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<style>
  .reason { white-space: normal; min-width: 16rem; }
  td .pill { margin-left: 0.4rem; }
  .beat { color: var(--text-dim); font-weight: 600; padding: 0 0.45rem; }
  .vs { padding: 0 0.4rem; }
</style>
