---
// One leaderboard: the bench tabs (SWE-bench style) and the bench's variants, the table, Figure 1 and the
// head-to-head grid, all over that board's games.
import { routes } from '../lib/routes';
import Base from '../layouts/Base.astro';
import LeaderboardTable from './LeaderboardTable.astro';
import ForestPlot from './ForestPlot.astro';
import { benchBoards, benchOf, benches, boardModels, boards, fmtDate, headToHeadFor, mainBoard, meta, modelsById, type Board } from '../lib/data';

interface Props { board: Board }
const { board } = Astro.props;
const models = await boardModels(board.id);
const headToHead = headToHeadFor(board.id);
const byId = await modelsById();
const anchor = byId.get(board.anchor || meta.ladder.anchor);  // each board has its own
const bench = benchOf(board);
const variants = bench ? benchBoards(bench) : [];
const combined = boards.filter((b) => b.kind !== 'benchmark');  // Overall, and categories once there are several
const href = (b: Board) => routes.board(b.id, b.id === mainBoard.id);

// Head-to-head grid over everyone who has played: cell (row, col) is row's record against col.
const played = models.filter((m) => m.games > 0);
const record = (a: string, b: string) => {
  const h = headToHead.find((x) => (x.a === a && x.b === b) || (x.a === b && x.b === a));
  if (!h) return null;
  return h.a === a ? { w: h.a_wins, l: h.b_wins, d: h.draws } : { w: h.b_wins, l: h.a_wins, d: h.draws };
};
---
<Base title={board === mainBoard ? 'Leaderboard' : `Leaderboard: ${board.title}`} description="RotomArena ratings with 95% bootstrap intervals, win rates, hallucination rates and cost per game.">
  <p class="eyebrow">{board.title} · {board.rated_matches} rated games · updated {fmtDate(meta.generated_at.slice(0, 10).replaceAll('-', ''))}</p>
  <h1>Leaderboard</h1>
  <nav class="tabs" aria-label="Benchmarks">
    {benches.map((b) => b.status === 'live' && b.main ? (
      <a href={routes.board(b.main, b.main === mainBoard.id)} aria-current={bench?.id === b.id ? 'page' : undefined}>{b.title}</a>
    ) : (
      <span class="tab-off" title={b.tagline}>{b.title} <small>soon</small></span>
    ))}
    {combined.map((b) => (
      <a href={href(b)} aria-current={b.id === board.id ? 'page' : undefined}>{b.kind === 'overall' ? 'All benchmarks' : b.title}</a>
    ))}
  </nav>
  {variants.length > 1 && (
    <nav class="subtabs" aria-label={`${bench!.title} leaderboards`}>
      {variants.map((v) => (
        <a href={href(v)} aria-current={v.id === board.id ? 'page' : undefined}>{v.title}</a>
      ))}
    </nav>
  )}
  {bench && <p class="prose bench-line">{bench.tagline} <a href={routes.bench(bench.id)}>About {bench.title} →</a></p>}
  <p class="prose"><strong>{board.description}</strong></p>
  <p class="prose">
    Ratings are on the Elo scale, fitted by Bradley-Terry over this board's rated games. Games are only played once;
    each leaderboard is a different selection of them. {anchor?.display_name} is
    fixed at {meta.ladder.anchor_rating} by definition; every other number is relative to it.<sup class="fn-ref"><a href="#fn-anchor">3</a></sup>
    Models with fewer than {meta.ladder.provisional_games} games are marked provisional. Click a column to sort.
  </p>

  <LeaderboardTable models={models} anchor={anchor?.config_id} />

  <details class="rules">
    <summary>Rules{board.versions.length > 1 ? ` of the ${board.versions.length} versions counted here` : ''}</summary>
    <p class="small muted">Every game records the rules it was played under; a board only rates games that match their version's stored rules.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Version</th><th>Format</th><th>Teams</th><th>Thinking</th><th class="r">Tokens per turn</th><th>Prompt</th></tr></thead>
        <tbody>
          {board.versions.map((v) => {
            const r = (meta.rulesets as Record<string, any>)[v];
            return r ? (
              <tr>
                <td class="num">{v}</td><td class="num">{r.format}</td>
                <td>{r.team_mode === 'draft' ? 'own (drafted)' : `fixed: ${r.teams.join(', ')}`}</td>
                <td>{r.reasoning}</td><td class="r num">{r.max_output_tokens.toLocaleString('en-US')}</td>
                <td class="num muted">{r.battle_prompt}{r.draft_prompt ? ` · draft ${r.draft_prompt}` : ''}</td>
              </tr>
            ) : <tr><td class="num">{v}</td><td colspan="5" class="muted">rules not stored</td></tr>;
          })}
        </tbody>
      </table>
    </div>
  </details>

  <ForestPlot
    models={models}
    anchor={anchor?.config_id ?? meta.ladder.anchor}
    caption={`<strong>Figure 1.</strong> Ratings with 95% parametric bootstrap intervals; the bars end at the interval bounds. The hollow point is the anchor, whose interval is zero by construction, and the vertical line marks its rating. Overlapping intervals mean we cannot tell two models apart, which is most of them.`}
  />

  <h2>Head to head</h2>
  <p class="small muted">Wins–losses of the row model against the column model.</p>
  <div class="table-scroll">
    <table class="h2h">
      <thead>
        <tr>
          <th></th>
          {played.map((m) => <th class="r" title={m.display_name}>{m.display_name}</th>)}
        </tr>
      </thead>
      <tbody>
        {played.map((row) => (
          <tr>
            <th scope="row"><a href={routes.model(row.config_id)}>{row.display_name}</a></th>
            {played.map((col) => {
              const r = row.config_id === col.config_id ? null : record(row.config_id, col.config_id);
              return (
                <td class={`r num ${r ? (r.w > r.l ? 'ahead' : r.w < r.l ? 'behind' : '') : 'empty'}`}>
                  {row.config_id === col.config_id ? '' : r ? `${r.w}–${r.l}${r.d ? `–${r.d}` : ''}` : '·'}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="footnotes">
    <ol>
      <li id="fn-ci">95% intervals come from {meta.ladder.bootstrap_samples.toLocaleString('en-US')} parametric bootstrap refits. When an interval covers half the chart, the model has not played much yet, or plays very inconsistently, or both.</li>
      <li id="fn-hallucination">Hallucination rate: the share of turns where the model gave no usable answer (named a move it does not have, answered in a format we could not read, rambled past its token budget, timed out or errored) and the default move was played on its behalf. Matches where either side does this on more than {meta.ladder.max_autopilot * 100}% of its turns are voided.</li>
      <li id="fn-anchor">Ratings need a reference point. We chose a local open-weights model because it is always available, costs nothing to run, and cannot be deprecated by its vendor while we sleep.</li>
    </ol>
  </section>
</Base>

<style>
  .rules { margin: 1rem 0; }
  .rules summary { cursor: pointer; font: 600 0.85rem var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1rem 0 0.4rem; }
  .tabs a {
    font: 600 0.85rem var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--text-dim);
    background: linear-gradient(180deg, rgba(30, 40, 80, 0.7), rgba(14, 20, 44, 0.7));
  }
  .tabs a:hover { color: var(--text); border-color: rgba(62, 230, 255, 0.55); text-shadow: none; }
  .tab-off { font: 600 0.85rem var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; padding: 0.45rem 0.9rem;
    border-radius: 999px; border: 1px dashed var(--line-strong); color: var(--text-faint); cursor: default; }
  .tab-off small { font-size: 0.7rem; letter-spacing: 0.1em; }
  .subtabs { display: flex; flex-wrap: wrap; gap: 0.2rem 1.2rem; margin: 0.6rem 0 0.2rem; padding: 0 0.3rem; }
  .subtabs a { font: 600 0.8rem var(--font-display); letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
    color: var(--text-dim); padding: 0.3rem 0; border-bottom: 2px solid transparent; }
  .subtabs a:hover { color: var(--text); text-shadow: none; }
  .subtabs a[aria-current='page'] { color: var(--cyan); border-bottom-color: var(--cyan); }
  .bench-line { color: var(--text-dim); margin-top: 0.8rem; }
  .tabs a[aria-current='page'] { color: #fff; border-color: transparent; background: var(--grad-primary) padding-box, var(--grad-primary-hot) border-box; box-shadow: 0 0 18px rgba(62, 230, 255, 0.35); }
  .h2h th[scope='row'] { text-transform: none; letter-spacing: 0; font-size: 0.9rem; font-weight: 500; }
  .h2h thead th { text-transform: none; letter-spacing: 0; font-size: 0.8rem; }
  .h2h td.ahead { color: var(--green); font-weight: 500; }
  .h2h td.behind { color: var(--red); }
  .h2h td.empty { color: var(--text-faint); }
</style>
