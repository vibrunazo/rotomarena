---
// One leaderboard: the bench tabs (SWE-bench style) and the bench's variants, the table, Figure 1 and the
// head-to-head grid, all over that board's games.
import { routes } from '../lib/routes';
import Base from '../layouts/Base.astro';
import LeaderboardTable from './LeaderboardTable.astro';
import ForestPlot from './ForestPlot.astro';
import CostRatingChart from './CostRatingChart.astro';
import { archivedBoards, benchBoards, benchOf, benches, boardHref, boardModels, boards, fmtDate, fmtInt, headToHeadFor, matchEntries, meta, modelsById, winner, type Board } from '../lib/data';

interface Props { board: Board }
const { board } = Astro.props;
const models = await boardModels(board.id);
const headToHead = headToHeadFor(board.id);
const byId = await modelsById();
const anchor = byId.get(board.anchor || meta.ladder.anchor);  // each board has its own
const bench = benchOf(board);
const current = bench ? benchBoards(bench)[0] : undefined;  // the bench's board now; older versions are archived
const isBench = !!bench && current?.id === board.id;  // this page is the benchmark itself
const archived = bench ? archivedBoards(bench) : [];
const combined = boards.filter((b) => b.kind !== 'benchmark');  // Overall, and categories once there are several

// The games behind each head-to-head record (this board's rated games), newest first: a record opens its list
const pairKey = (a: string, b: string) => [a, b].sort().join('|');
const games: Record<string, [string, string, string | null, number][]> = {};  // [slug, date, winner id, turns]
for (const { slug, data: m } of await matchEntries()) {
  if (!m.version || !board.versions.includes(m.version) || m.void_reason || m.players.length !== 2) continue;
  (games[pairKey(m.players[0].config_id, m.players[1].config_id)] ??= []).push([slug, fmtDate(m.date), winner(m)?.config_id ?? null, m.turns]);
}

// Head-to-head grid over everyone who has played: cell (row, col) is row's record against col.
const played = models.filter((m) => m.games > 0);
const record = (a: string, b: string) => {
  const h = headToHead.find((x) => (x.a === a && x.b === b) || (x.a === b && x.b === a));
  if (!h) return null;
  return h.a === a ? { w: h.a_wins, l: h.b_wins, d: h.draws } : { w: h.b_wins, l: h.a_wins, d: h.draws };
};
---
<Base title={isBench ? bench!.title : `Leaderboard: ${board.title}`} description={isBench ? bench!.tagline : "RotomArena ratings with 95% bootstrap intervals, win rates, hallucination rates and cost per game."}>
  <p class="eyebrow">{isBench ? `Benchmark · ${board.title}` : board.title} · {fmtInt(board.rated_matches)} rated games · updated {fmtDate(meta.generated_at.slice(0, 10).replaceAll('-', ''))}</p>
  <h1>{isBench ? bench!.title : board.kind === 'overall' ? 'All benchmarks' : board.title}</h1>
  <nav class="tabs" aria-label="Benchmarks">
    {benches.map((b) => b.status === 'live' && b.main ? (
      <a href={routes.bench(b.id)} aria-current={isBench && bench?.id === b.id ? 'page' : undefined}>{b.title}</a>
    ) : (
      <span class="tab-off" title={b.tagline}>{b.title} <small>soon</small></span>
    ))}
    {combined.map((b) => (
      <a href={boardHref(b)} aria-current={b.id === board.id ? 'page' : undefined}>{b.kind === 'overall' ? 'All benchmarks' : b.title}</a>
    ))}
  </nav>
  {board.archived && <p class="prose archived-note"><strong>Archived.</strong> A superseded version, kept for the record; its games
    count on no current leaderboard. {current && bench && <>The current one is <a href={routes.bench(bench.id)}>{bench.title}</a>.</>}</p>}
  {isBench && <p class="lede prose">{bench!.tagline}</p>}
  {isBench && bench!.description && <p class="prose">{bench!.description}</p>}
  {isBench && <p class="cta"><a class="hud-btn" href={`${routes.teams}#${bench!.id}`}>The teams</a></p>}
  {!isBench && <p class="prose"><strong>{board.description}</strong></p>}
  <p class="prose">
    Ratings are on the Elo scale, fitted by Bradley-Terry over this board's rated games. Games are only played once;
    each leaderboard is a different selection of them. {anchor?.display_name} is
    fixed at {meta.ladder.anchor_rating} by definition; every other number is relative to it.<sup class="fn-ref"><a href="#fn-anchor">3</a></sup>
    Models with fewer than {meta.ladder.provisional_games} games are marked provisional. Click a column to sort.
  </p>

  <LeaderboardTable models={models} anchor={anchor?.config_id} />

  <details class="rules">
    <summary>Rules{board.versions.length > 1 ? ` of the ${board.versions.length} versions counted here` : ''}</summary>
    <p class="small muted">Every game records the rules it was played under; a board only rates games that match their version's stored rules.</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th>Version</th><th>Format</th><th>Teams</th><th>Bring</th><th>Thinking per turn</th><th class="r">Tokens per turn</th><th>Prompt</th></tr></thead>
        <tbody>
          {board.versions.map((v) => {
            const r = (meta.rulesets as Record<string, any>)[v];
            return r ? (
              <tr>
                <td class="num">{v}</td><td class="num">{r.format}</td>
                <td>{r.team_mode === 'draft' ? 'own (drafted)' : r.team_mode === 'random' ? 'dealt at random' : `fixed: ${r.teams.join(', ')}`}</td>
                <td class="num">{r.pick ? `${r.pick} of 6` : 'all 6'}</td>
                <td class="num">{r.thinking_budget ? `${r.thinking_budget.toLocaleString('en-US')} tokens` : r.reasoning}</td>
                <td class="r num">{r.max_output_tokens.toLocaleString('en-US')}</td>
                <td class="num muted">{r.battle_prompt}{r.draft_prompt ? ` · draft ${r.draft_prompt}` : ''}</td>
              </tr>
            ) : <tr><td class="num">{v}</td><td colspan="6" class="muted">rules not stored</td></tr>;
          })}
        </tbody>
      </table>
    </div>
  </details>

  <ForestPlot
    models={models}
    anchor={anchor?.config_id ?? meta.ladder.anchor}
    caption={`<strong>Figure 1.</strong> Ratings with 95% parametric bootstrap intervals; the bars end at the interval bounds. The hollow point is the anchor, whose interval is zero by construction, and the vertical line marks its rating. Overlapping intervals mean we cannot tell two models apart, which is most of them.`}
  />

  {isBench && (
    <CostRatingChart
      models={models}
      caption={`<strong>Figure 2.</strong> Rating against cost per game. The dotted line is the Pareto frontier: no model is both cheaper and better than a model on it. The shaded quadrant is better and cheaper than the median paid model. The dashed lines are the control bots, who cost nothing and are not invited to the frontier.`}
    />
  )}

  <h2>Head to head</h2>
  <p class="small muted">Wins–losses of the row model against the column model. Click a record for its games and replays.</p>
  <div class="table-scroll">
    <table class="h2h">
      <thead>
        <tr>
          <th></th>
          {played.map((m) => <th class="r" title={m.display_name}>{m.display_name}</th>)}
        </tr>
      </thead>
      <tbody>
        {played.map((row) => (
          <tr>
            <th scope="row"><a href={routes.model(row.config_id)}>{row.display_name}</a></th>
            {played.map((col) => {
              const r = row.config_id === col.config_id ? null : record(row.config_id, col.config_id);
              return (
                <td class={`r num ${r ? (r.w > r.l ? 'ahead' : r.w < r.l ? 'behind' : '') : 'empty'}`}>
                  {row.config_id === col.config_id ? '' : r && games[pairKey(row.config_id, col.config_id)]
                    ? <button type="button" class="rec" data-a={row.config_id} data-b={col.config_id}>{`${r.w}–${r.l}${r.d ? `–${r.d}` : ''}`}</button>
                    : r ? `${r.w}–${r.l}${r.d ? `–${r.d}` : ''}` : '·'}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <dialog id="h2h-dialog" class="h2h-dialog">
    <form method="dialog"><button class="close" aria-label="Close">×</button></form>
    <h3 id="h2h-title"></h3>
    <ol id="h2h-list" class="h2h-games"></ol>
  </dialog>
  <script type="application/json" id="h2h-data" set:html={JSON.stringify({
    games, names: Object.fromEntries(played.map((m) => [m.config_id, m.display_name])), base: routes.matches,
  })} />

  <section class="footnotes">
    <ol>
      <li id="fn-ci">95% intervals come from {meta.ladder.bootstrap_samples.toLocaleString('en-US')} parametric bootstrap refits. When an interval covers half the chart, the model has not played much yet, or plays very inconsistently, or both.</li>
      <li id="fn-hallucination">Hallucination rate: the share of turns where the model gave no usable answer (named a move it does not have, answered in a format we could not read, rambled past its token budget, timed out or errored) and the default move was played on its behalf. Matches where either side does this on more than {meta.ladder.max_autopilot * 100}% of its turns are voided.</li>
      <li id="fn-anchor">Ratings need a reference point. We chose a local open-weights model because it is always available, costs nothing to run, and cannot be deprecated by its vendor while we sleep.</li>
      {isBench && archived.length > 0 && <li id="fn-versions">Older versions of this benchmark, retired when their rules changed, are in the <a href={`${routes.archive}#${bench!.id}`}>archive</a>.</li>}
    </ol>
  </section>
</Base>

<script>
  // A head-to-head record opens the list of that pair's games, each with its replay
  const data = JSON.parse(document.getElementById('h2h-data')?.textContent || '{}');
  const dialog = document.getElementById('h2h-dialog') as HTMLDialogElement | null;
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  document.querySelectorAll<HTMLButtonElement>('.h2h .rec').forEach((button) => button.addEventListener('click', () => {
    const a = button.dataset.a!, b = button.dataset.b!;
    const list = data.games[[a, b].sort().join('|')] || [];
    const name = (id: string) => esc(data.names[id] || id);
    document.getElementById('h2h-title')!.innerHTML = `${name(a)} <span class="muted">vs</span> ${name(b)} · ${button.textContent}`;
    document.getElementById('h2h-list')!.innerHTML = list.map(([slug, date, w, turns]: [string, string, string | null, number]) => {
      const result = w ? `<strong>${name(w)}</strong> won` : 'Draw';
      return `<li><span class="num muted">${esc(date)}</span> ${result} <span class="muted">in ${turns} turns</span> <a href="${data.base}${slug}/">Replay</a></li>`;
    }).join('');
    dialog?.showModal();
  }));
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });  // a click outside closes it
</script>

<style>
  .rules { margin: 1rem 0; }
  .rules summary { cursor: pointer; font: 600 0.85rem var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1rem 0 0.4rem; }
  .tabs a {
    font: 600 0.85rem var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--text-dim);
    background: linear-gradient(180deg, rgba(30, 40, 80, 0.7), rgba(14, 20, 44, 0.7));
  }
  .tabs a:hover { color: var(--text); border-color: rgba(62, 230, 255, 0.55); text-shadow: none; }
  .tab-off { font: 600 0.85rem var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; padding: 0.45rem 0.9rem;
    border-radius: 999px; border: 1px dashed var(--line-strong); color: var(--text-faint); cursor: default; }
  .tab-off small { font-size: 0.7rem; letter-spacing: 0.1em; }
  .subtabs { display: flex; flex-wrap: wrap; gap: 0.2rem 1.2rem; margin: 0.6rem 0 0.2rem; padding: 0 0.3rem; }
  .subtabs a { font: 600 0.8rem var(--font-display); letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
    color: var(--text-dim); padding: 0.3rem 0; border-bottom: 2px solid transparent; }
  .subtabs a:hover { color: var(--text); text-shadow: none; }
  .subtabs a[aria-current='page'] { color: var(--cyan); border-bottom-color: var(--cyan); }
  .bench-line { color: var(--text-dim); margin-top: 0.8rem; }
  .tabs a[aria-current='page'] { color: #fff; border-color: transparent; background: var(--grad-primary) padding-box, var(--grad-primary-hot) border-box; box-shadow: 0 0 18px rgba(62, 230, 255, 0.35); }
  .h2h th[scope='row'] { text-transform: none; letter-spacing: 0; font-size: 0.9rem; font-weight: 500; }
  .h2h thead th { text-transform: none; letter-spacing: 0; font-size: 0.8rem; }
  .h2h td.ahead { color: var(--green); font-weight: 500; }
  .h2h td.behind { color: var(--red); }
  .h2h td.empty { color: var(--text-faint); }
  .h2h .rec { all: unset; cursor: pointer; border-bottom: 1px dotted currentColor; }
  .h2h .rec:hover, .h2h .rec:focus-visible { color: var(--cyan); border-bottom-style: solid; }
  .h2h-dialog { background: var(--panel-solid); color: var(--text); border: 1px solid var(--line-strong);
    border-radius: var(--radius); padding: 1rem 1.2rem 1.2rem; width: min(34rem, calc(100vw - 2rem)); box-shadow: var(--shadow-panel); }
  .h2h-dialog::backdrop { background: rgba(3, 5, 14, 0.7); }
  .h2h-dialog h3 { margin: 0 2rem 0.6rem 0; font-size: 1.05rem; }
  .h2h-dialog .close { position: absolute; top: 0.5rem; right: 0.7rem; background: none; border: 0; color: var(--text-dim);
    font-size: 1.4rem; cursor: pointer; }
  .h2h-games { margin: 0; padding-left: 1.4rem; display: grid; gap: 0.35rem; }
</style>
