---
// The main table. Click a column header to sort. Only rated models (language and decision) get a rank; bots are scenery.
import { routes } from '../lib/routes';
import Rating from './Rating.astro';
import { fmtCost, fmtPct, isModel, meta, provisionalTitle, quantTitle, roleLabel, roleTitle, type Model } from '../lib/data';

interface Props { models: Model[]; compact?: boolean; anchor?: string }
const { models, compact = false, anchor } = Astro.props;
// The anchor pill marks this board's anchor; a model that anchors another board is just a model here
const role = (m: Model) => (m.config_id === anchor ? 'anchor' : m.role === 'anchor' ? 'contestant' : m.role);
let rank = 0;
const rows = models.map((m) => ({ m, rank: m.rating !== null && isModel(m) ? ++rank : null }));
const tiers = ((meta as any).price_tiers ?? []) as { name: string; low: number; high: number | null }[];
const SMALL_B = 36;  // "small": published total parameters, 36B or less
const tierTitle = (t: { name: string; low: number; high: number | null }) =>
  t.high === 0 ? 'Costs nothing: local models and free tiers' :
  `Cost per game in the main benchmark: ${t.low ? `$${t.low}` : '$0'}${t.high ? ` to $${t.high}` : ' and up'}`;
---
{!compact && (
  <div class="filters" data-filters>
    <span class="group"><span class="label">Structure</span>
      <button type="button" data-filter="structure" data-value="" aria-pressed="true">all</button>
      <button type="button" data-filter="structure" data-value="llm" aria-pressed="false" title="Language models: they write their move as text">LLM</button>
      <button type="button" data-filter="structure" data-value="system1" aria-pressed="false" title="System-1 decision models: a probability for each legal move, no text">System-1</button>
      <button type="button" data-filter="structure" data-value="bot" aria-pressed="false" title="Scripted players: the chimps, which pick at random, and PokéChamp, a one-turn search">bot</button>
    </span>
    <span class="group">
      <button type="button" data-filter="open" data-value="1" aria-pressed="false" data-toggle title="Models whose weights are published">open weights</button>
      <button type="button" data-filter="small" data-value="1" aria-pressed="false" data-toggle title={`Published total size of ${SMALL_B}B parameters or less (undisclosed sizes are left out)`}>{SMALL_B}B or smaller</button>
    </span>
    {tiers.length > 0 && <span class="group"><span class="label">Price</span>
      <button type="button" data-filter="tier" data-value="" aria-pressed="true">all</button>
      {tiers.map((t) => <button type="button" data-filter="tier" data-value={t.name} aria-pressed="false" data-multi title={`${tierTitle(t)} (pick several to combine them)`}>{t.name}</button>)}
    </span>}
  </div>
)}
<div class="table-scroll">
  <table class="leaderboard" data-sortable>
    <thead>
      <tr>
        <th class="r" data-sort="num">#</th>
        <th data-sort="text">Model</th>
        <th class="r" data-sort="num">Rating (95% CI){!compact && <sup class="fn-ref"><a href="#fn-ci">1</a></sup>}</th>
        <th class="r" data-sort="num">Games</th>
        {!compact && <th class="r" data-sort="num" title="Wins">W</th>}
        {!compact && <th class="r" data-sort="num" title="Losses">L</th>}
        <th class="r" data-sort="num">Win rate</th>
        {!compact && <th class="r" data-sort="num" title="Hallucination rate: turns with no usable answer, played by default">Halluc.<sup class="fn-ref"><a href="#fn-hallucination">2</a></sup></th>}
        {!compact && <th class="r" data-sort="num">Tokens / turn</th>}
        {!compact && <th class="r" data-sort="num">Cost / game</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map(({ m, rank }) => (
        <tr data-structure={isModel(m) ? (m.type === 'decision' ? 'system1' : 'llm') : 'bot'} data-open={m.weights === 'open' ? '1' : '0'}
            data-small={m.params_b != null && m.params_b <= SMALL_B ? '1' : '0'} data-tier={m.price_tier ?? ''} data-ranked={rank ? '1' : '0'}>
          <td class="r num rank" data-value={rank ?? 999}>{rank ?? '—'}</td>
          <td data-value={m.display_name}>
            <a href={routes.model(m.config_id)}>{m.display_name}</a>
            {roleLabel(role(m)) && <span class="pill" title={roleTitle(role(m), m.type)}>{roleLabel(role(m))}</span>}
            {m.provisional && <span class="pill warn" title={provisionalTitle(meta.ladder.provisional_games)}>provisional</span>}
            {m.quantization && <span class="muted small quant" title={quantTitle(m.quantization)}> {m.quantization}</span>}
          </td>
          <td class="r" data-value={m.rating ?? -1}><Rating model={m} /></td>
          <td class="r num" data-value={m.games}>{m.games}</td>
          {!compact && <td class="r num" data-value={m.wins}>{m.wins}</td>}
          {!compact && <td class="r num" data-value={m.losses}>{m.losses}</td>}
          <td class="r num" data-value={m.win_rate}>{fmtPct(m.win_rate)}</td>
          {!compact && <td class="r num" data-value={m.autopilot_rate}>{isModel(m) ? fmtPct(m.autopilot_rate, 1) : '—'}</td>}
          {!compact && <td class="r num" data-value={m.tokens_per_turn ?? -1}>{m.tokens_per_turn?.toLocaleString('en-US') ?? '—'}</td>}
          {!compact && <td class="r num" data-value={m.cost_per_game_usd}>{isModel(m) ? fmtCost(m.cost_per_game_usd) : '—'}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  // Filters: hide the rows that don't match, and number the rated models that remain (the ratings themselves are
  // fitted over everyone, so they don't change). Bots show unfiltered, or alone under Structure: bot. Price tiers
  // combine (free + pocket change + cheap); "all" clears them.
  for (const bar of document.querySelectorAll<HTMLElement>('[data-filters]')) {
    const table = bar.nextElementSibling!.querySelector('table')!;
    const state: Record<string, string> = { structure: '', open: '', small: '' };
    const tiers = new Set<string>();
    const apply = () => {
      const active = Object.values(state).some(Boolean) || tiers.size > 0;
      let n = 0;
      const rows = [...table.tBodies[0].rows].sort((a, b) =>
        Number(a.querySelector<HTMLElement>('.rank')!.dataset.value) - Number(b.querySelector<HTMLElement>('.rank')!.dataset.value));
      for (const row of rows) {
        const d = row.dataset;
        const show = (!active || d.structure !== 'bot' || state.structure === 'bot') && (!state.structure || d.structure === state.structure) &&
          (!state.open || d.open === '1') && (!state.small || d.small === '1') && (!tiers.size || tiers.has(d.tier ?? ''));
        row.hidden = !show;
        const cell = row.querySelector<HTMLElement>('.rank')!;
        if (d.ranked === '1') cell.textContent = show ? String(++n) : cell.dataset.value!;
      }
    };
    bar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      const key = btn.dataset.filter!;
      if (btn.hasAttribute('data-multi')) {
        const value = btn.dataset.value!;
        if (!tiers.delete(value)) tiers.add(value);
        btn.setAttribute('aria-pressed', String(tiers.has(value)));
        bar.querySelector(`button[data-filter="${key}"][data-value=""]`)!.setAttribute('aria-pressed', String(!tiers.size));
      } else if (key === 'tier') {  // "all"
        tiers.clear();
        bar.querySelectorAll(`button[data-filter="${key}"]`).forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      } else if (btn.hasAttribute('data-toggle')) {
        state[key] = state[key] ? '' : btn.dataset.value!;
        btn.setAttribute('aria-pressed', String(!!state[key]));
      } else {
        state[key] = btn.dataset.value!;
        bar.querySelectorAll(`button[data-filter="${key}"]`).forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      }
      apply();
    });
  }

  // Sort by clicking a header; a second click reverses. Rows keep their data-value for numbers.
  for (const table of document.querySelectorAll<HTMLTableElement>('table[data-sortable]')) {
    const headers = [...table.tHead!.rows[0].cells];
    headers.forEach((th, col) => {
      const kind = th.dataset.sort;
      if (!kind) return;
      th.tabIndex = 0;
      th.style.cursor = 'pointer';
      let ascending = col <= 1;
      const sort = () => {
        const body = table.tBodies[0];
        const rows = [...body.rows];
        const key = (row: HTMLTableRowElement) => row.cells[col].dataset.value ?? row.cells[col].textContent ?? '';
        rows.sort((a, b) => {
          const [x, y] = [key(a), key(b)];
          const d = kind === 'num' ? Number(x) - Number(y) : x.localeCompare(y);
          return ascending ? d : -d;
        });
        body.append(...rows);
        ascending = !ascending;
      };
      th.addEventListener('click', sort);
      th.addEventListener('keydown', (e) => { if (e.key === 'Enter') sort(); });
    });
  }
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0.75rem 0; font-size: 0.85rem; }
  .filters .group { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
  .filters .label { color: var(--muted, #8a93a6); margin-right: 0.15rem; }
  .filters button { font: inherit; padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid var(--border, #2a3550);
    background: transparent; color: inherit; cursor: pointer; }
  .filters button[aria-pressed="true"] { border-color: var(--accent, #43e0ff); color: var(--accent, #43e0ff); }
  .leaderboard td .pill { margin-left: 0.4rem; }
  .leaderboard td a { font-weight: 500; }
</style>
