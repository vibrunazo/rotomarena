---
import { leaderboardHref } from '../lib/data';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page fainted.">
  <p class="eyebrow">Error 404</p>
  <h1>This page fainted.</h1>
  <p class="prose">
    The page you were looking for is unable to battle. It may have been moved, retracted, or never existed, which
    in our experience is the most common case. <a href={leaderboardHref()}>Return to the leaderboard</a>.
  </p>
</Base>
