---
import { routes } from '../lib/routes';
import Base from '../layouts/Base.astro';
import LeaderboardTable from '../components/LeaderboardTable.astro';
import Findings from '../components/Findings.astro';
import { boardModels, boards, fmtDate, fmtInt, isModel, mainBoard, meta } from '../lib/data';

const models = await boardModels();
const llms = models.filter((m) => isModel(m));
const stats = [
  [fmtInt(meta.rated_matches), 'rated matches'],
  [fmtInt(meta.turns), 'turns analysed'],
  [fmtInt(meta.tokens), 'tokens processed'],
  [fmtInt(llms.length), 'language models'],
];
---
<Base title="RotomArena">
  <section class="hero">
    <p class="eyebrow">{boards.length - 1} {boards.length === 2 ? 'benchmark' : 'benchmarks'} · {fmtInt(meta.rated_matches)} rated games</p>
    <h1>Which language model is best at Pokémon?</h1>
    <p class="lede prose">
      Other benchmarks measure how well AI agents write code. RotomArena measures what people actually care about.
    </p>
    <p class="prose">
      Language models play full competitive Pokémon battles (Gen 9 OU, fixed teams, both sides) against each other
      and a set of calibrated reference opponents. Ratings are fitted with a Bradley-Terry model and reported with
      95% bootstrap intervals, because we are a serious benchmark.<sup class="fn-ref"><a href="#fn-serious">1</a></sup>
    </p>
    <p class="cta">
      <a class="hud-cta" href={routes.leaderboard}>View the leaderboard</a>
      <a class="hud-btn" href={routes.paper}>Read the paper</a>
    </p>
  </section>

  <dl class="stats">
    {stats.map(([value, label]) => (
      <div><dt class="num">{value}</dt><dd class="small muted">{label}</dd></div>
    ))}
  </dl>

  <h2>Current standings</h2>
  <p class="small muted">{mainBoard.title}: {mainBoard.description}</p>
  <LeaderboardTable models={models} compact />
  <p class="small muted">Updated {fmtDate(meta.generated_at.slice(0, 10).replaceAll('-', ''))}. <a href={routes.leaderboard}>Full leaderboard, intervals and head-to-head results →</a></p>

  <h2>Key findings</h2>
  <Findings />

  <section class="footnotes">
    <ol>
      <li id="fn-serious">We also report confidence intervals for Random AI, a bot that picks a legal action uniformly at random. It has one.</li>
    </ol>
  </section>
</Base>

<style>
  .hero { padding-block: 1rem 1.5rem; }
  .hero h1 { max-width: 16ch; margin: 0.6rem 0 1rem; }
  .lede { font-size: 1.3rem; line-height: 1.45; color: var(--text); }
  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); background: var(--hud-panel);
    border: 1px solid transparent; border-radius: var(--radius-lg); overflow: hidden; margin: 2rem 0 0; box-shadow: var(--shadow-panel); }
  .stats div { padding: 1rem 1.2rem; box-shadow: 1px 0 0 var(--line), 0 1px 0 var(--line); }
  .stats dt { font-size: 1.7rem; font-weight: 500; color: var(--cyan); text-shadow: var(--glow-text); }
  .stats dd { margin: 0.2rem 0 0; font: 600 0.75rem/1.2 var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-dim); }
</style>
