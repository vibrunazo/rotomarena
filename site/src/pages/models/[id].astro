---
import Base from '../../layouts/Base.astro';
import MatchList from '../../components/MatchList.astro';
import { getCollection, render } from 'astro:content';
import Rating from '../../components/Rating.astro';
import DraftedTeam from '../../components/DraftedTeam.astro';
import { allModels, boardModels, boards, fmtPct, matchEntries, meta, roleLabel, type Model } from '../../lib/data';

export async function getStaticPaths() {
  return (await allModels()).map((model) => ({ params: { id: model.config_id }, props: { model } }));
}

const { model: m } = Astro.props as { model: Model };
const llm = m.type === 'direct_llm';
const ranked = (await boardModels()).filter((x) => x.rating !== null && x.type === 'direct_llm');
const rank = ranked.findIndex((x) => x.config_id === m.config_id) + 1;
const matches = (await matchEntries()).filter((e) => e.data.players.some((p) => p.config_id === m.config_id));
const draft = (await getCollection('drafts')).find((entry) => entry.id === m.config_id)?.data;
const about = (await getCollection('about')).find((entry) => entry.id === m.config_id); // most models have none
const About = about ? (await render(about)).Content : null;
const pretty = (id: string | null) => (id ? id.replace(/^./, (c) => c.toUpperCase()) : '—');

const kind: Record<string, string> = {
  direct_llm: 'Language model',
  pokechamp: 'Search bot (one-turn minimax)',
  random: 'Uniform random policy',
  heuristic: 'Rule-based bot',
};
const facts: [string, string][] = [
  ['Rank', llm && rank ? `${rank} of ${ranked.length}` : '—'],
  ['Record', `${m.wins}–${m.losses}${m.draws ? `–${m.draws}` : ''}`],
  ['Win rate', fmtPct(m.win_rate)],
  ['Turns played', m.turns.toLocaleString('en-US')],
  ['Switch rate', fmtPct(m.switch_rate)],
  ['Median Terastallization turn', m.median_tera_turn === null ? 'never' : `turn ${m.median_tera_turn}`],
  ...(llm
    ? ([
        ['Autopilot rate', fmtPct(m.autopilot_rate, 1)],
        ['Hallucinated moves', fmtPct(m.hallucinated_move_rate, 1)],
        ['Tokens per turn', m.tokens_per_turn?.toLocaleString('en-US') ?? '—'],
        ['Cost per game', `$${m.cost_per_game_usd.toFixed(2)}`],
      ] as [string, string][])
    : []),
];
---
<Base title={m.display_name} description={`${m.display_name} on RotomArena: rating, record and every decision it made.`}>
  <p class="eyebrow">{kind[m.type] ?? m.type}{roleLabel(m.role) && ` · ${roleLabel(m.role)}`}</p>
  <h1>{m.display_name}</h1>
  <p class="muted small id-line">
    {m.model && <code>{m.model}</code>}
    {m.provider && <span> via {m.provider === 'local' ? 'llama.cpp, on one consumer GPU' : m.provider}</span>}
    {m.quantization && <span> · {m.quantization}</span>}
    {m.provisional && <span class="pill warn">provisional</span>}
  </p>

  {m.config_id === meta.ladder.anchor && (
    <p class="prose note">This model is the anchor. Its rating is {meta.ladder.anchor_rating} by definition and has never been in doubt.</p>
  )}

  <dl class="facts">
    <div><dt class="small muted">Rating (95% CI)</dt><dd><Rating model={m} /></dd></div>
    {facts.map(([k, v]) => (<div><dt class="small muted">{k}</dt><dd class="num">{v}</dd></div>))}
  </dl>

  {About && (
    <section class="about prose">
      <h2>{about!.data.title}</h2>
      <About />
    </section>
  )}

  {Object.keys(m.boards).length > 1 && (
    <section>
      <h2>By leaderboard</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Leaderboard</th><th class="r">Rating (95% CI)</th><th class="r">Games</th><th class="r">Record</th></tr></thead>
          <tbody>
            {boards.filter((b) => m.boards[b.id]).map((b) => {
              const s = m.boards[b.id];
              return (
                <tr>
                  <td><a href={b === boards[0] ? '/leaderboard/' : `/leaderboard/${b.id}/`}>{b.title}</a></td>
                  <td class="r"><Rating model={s} /></td>
                  <td class="r num">{s.games}</td>
                  <td class="r num">{s.wins}–{s.losses}{s.draws ? `–${s.draws}` : ''}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <div class="cols">
    <section>
      <h2>Style</h2>
      <dl class="style">
        <dt>Signature move</dt><dd>{pretty(m.signature_move)}</dd>
        <dt>Most time on the field</dt><dd>{pretty(m.most_used_pokemon)}</dd>
      </dl>
      {m.hallucinations.length > 0 && (
        <>
          <h3>Moves it believes it has</h3>
          <ul class="small">
            {m.hallucinations.map((h) => <li><code>{h.action}</code> × {h.count}</li>)}
          </ul>
        </>
      )}
    </section>
    {m.longest_thought && (
      <section>
        <h2>In its own words</h2>
        <figure class="quote">
          <blockquote>{m.shortest_thought}</blockquote>
          <figcaption>Shortest explanation on record.</figcaption>
        </figure>
        <figure class="quote">
          <blockquote>{m.longest_thought}</blockquote>
          <figcaption>Longest explanation on record.</figcaption>
        </figure>
      </section>
    )}
  </div>

  {draft && (
    <>
      <h2>Its own team</h2>
      <p class="prose small muted">Built by the model itself from the rules of the format. <a href="/teams/">How teams are built</a>.</p>
      <DraftedTeam draft={draft} />
    </>
  )}

  <h2>Matches</h2>
  {matches.length ? <MatchList matches={matches} /> : <p class="muted">No rated matches yet.</p>}
</Base>

<style>
  .id-line { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: baseline; margin-top: 0.6rem; font-family: var(--font-body); }
  .note { border-left: 3px solid var(--cyan); padding-left: 0.8rem; color: var(--text-dim); }
  .facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); background: var(--hud-panel);
    border: 1px solid transparent; border-radius: var(--radius); overflow: hidden; margin: 1.5rem 0; box-shadow: var(--shadow-panel); }
  /* Cell rules as shadows: the ones on the outer edge are clipped, and empty trailing cells stay blank. */
  .facts div { padding: 0.7rem 0.9rem; box-shadow: 1px 0 0 var(--line), 0 1px 0 var(--line); }
  .facts dt { font: 600 0.75rem/1.2 var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; }
  .facts dd { margin: 0.25rem 0 0; font: 1.15rem var(--font-mono); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 0 2.5rem; }
  .style { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1rem; font-family: var(--font-body); }
  .style dt { color: var(--text-dim); }
  .style dd { margin: 0; font-weight: 500; }
  .quote { margin: 0.8rem 0 1.2rem; }
  .about :global(h2) { font-size: 1.3rem; margin-top: 1.8rem; }
  .about > h2 { font-size: 1.7rem; margin-top: 2.6rem; }
  .about :global(ol) { padding-left: 1.3rem; }
  .about :global(li) { margin: 0.45rem 0; }
  .about :global(strong) { color: var(--text); }
  .about :global(.credit) {
    margin: 1rem 0 0; padding: 0.9rem 1.1rem; border: 1px solid transparent; border-radius: var(--radius);
    background: var(--grad-panel) padding-box, var(--grad-primary) border-box; box-shadow: 0 0 22px rgba(62, 230, 255, 0.15);
  }
  .about :global(.credit p:first-child) { margin-top: 0; }
  .about :global(.credit p:last-child) { margin-bottom: 0; }
  blockquote { margin: 0; padding: 0.7rem 1rem; background: var(--hud-panel); border: 1px solid transparent; border-radius: 8px; font-style: italic; }
</style>
