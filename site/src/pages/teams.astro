---
import Base from '../layouts/Base.astro';
import DraftedTeam from '../components/DraftedTeam.astro';
import { allDrafts, benches, type Draft } from '../lib/data';
import { routes } from '../lib/routes';
import reference from '../data/reference_teams.json';

const all = await allDrafts();
// One section per benchmark with teams, in the benches' order
const groups = benches.filter((b) => all.some((d) => d.bench === b.id)).map((bench) => {
  const benchDrafts = all.filter((d) => d.bench === bench.id);
  // a model's drafts stay together, in order; models with every draft legal first, then fewer attempts
  const byModel = new Map<string, Draft[]>();
  for (const d of benchDrafts) byModel.set(d.config_id, [...(byModel.get(d.config_id) ?? []), d]);
  const models = [...byModel.values()].map((ds) => ds.sort((a, b) => a.draft - b.draft))
    .sort((a, b) => Number(b.every((d) => d.legal)) - Number(a.every((d) => d.legal))
      || a.reduce((n, d) => n + d.attempts.length, 0) - b.reduce((n, d) => n + d.attempts.length, 0));
  const drafts = models.flat();
  const legalModels = models.filter((ds) => ds.some((d) => d.legal));
  const legal = drafts.filter((d) => d.legal);
  // most drafted: a Pokémon counts once per model, in any of its legal drafts
  const picks = Object.entries(
    legalModels.flatMap((ds) => [...new Set(ds.filter((d) => d.legal).flatMap((d) => d.members.map((m) => m.species)))])
      .reduce<Record<string, number>>((acc, s) => ((acc[s] = (acc[s] ?? 0) + 1), acc), {}),
  ).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
  const unanimous = picks.filter(([, n]) => legalModels.length > 1 && n === legalModels.length).map(([s]) => s);
  // The meta score: how many of a team's own picks appear in at least one of Smogon's sample teams (Gen 9 OU only)
  const byMeta = [...drafts].filter((d) => d.meta.of > 0 && d.meta.sample_teams > 0)
    .sort((a, b) => b.meta.used - a.meta.used || b.meta.slots - a.meta.slots || a.display_name.localeCompare(b.display_name));
  return { bench, drafts, legal: legalModels, picks, unanimous, byMeta, sampleTeams: drafts[0]?.meta.sample_teams ?? 0 };
});
const refs = (reference.teams as { title: string; archetype: string; builder: string; url: string; legal: boolean }[]);
---
<Base title="Teambuilding" description="The teams the models built for themselves, and the validator that judged them.">
  <p class="eyebrow">Teambuilding</p>
  <h1>Teams</h1>
  <div class="prose">
    <p>
      In every benchmark, each model builds its own team, in two steps. First it picks six Pokémon, given the rules
      of the format: the clauses, the banned abilities, moves and items, and the list of legal Pokémon. Then it gets the
      abilities and moves each of its six can legally have, and builds their sets. That is the same kind of help a
      player gets in a battle, where the legal moves are listed: rules, not strategy. It is not given usage
      statistics, sample teams or advice. What it builds is up to it.
    </p>
    <p>
      Each step is checked, the picks against the list and the finished team by Pokémon Showdown's validator, exactly
      as it checks a human player's. Anything illegal is sent back with the exact problems, and the model gets up to
      five attempts per step. A model that
      never gets there still plays: its last team is repaired by replacing only what the validator rejected, with
      deliberately unremarkable choices, so the mistake costs it something without costing it its place. Every
      attempt and every repair is published below.
    </p>
  </div>

  {groups.length > 1 && (
    <nav class="bench-jump" aria-label="Benchmarks">{groups.map((g) => <a href={`#${g.bench.id}`}>{g.bench.title}</a>)}</nav>
  )}

  {groups.map(({ bench, drafts, legal, picks, unanimous, byMeta, sampleTeams }) => (
  <section id={bench.id} class="bench-section">
  <h2 class="bench-title">{bench.title}</h2>
  <p class="prose muted">{bench.tagline}</p>
  {unanimous.length > 0 && (
    <p class="prose">
      So far, {legal.length === 2 ? 'both' : `all ${legal.length}`} models that built a legal team chose
      {' '}{unanimous.join(', ').replace(/, ([^,]*)$/, ' and $1')}. Whether this reflects the metagame or a shared memory of it
      is a question we have chosen not to investigate.
    </p>
  )}

  {sampleTeams > 0 && byMeta.length > 0 && (
    <>
      <h3>Meta score</h3>
      <p class="prose">
        How many of each model's own picks appear in at least one of Smogon's {sampleTeams} sample teams (listed under
        <a href="#reference-teams">Reference teams</a> below), and how many sample-team slots they fill between them.
        Fallbacks, the Pokémon the referee put in when a model's pick was missing or illegal, aren't its choice and
        don't count.
        A rough yardstick: it judges the picks, not the sets, and the sample teams are one snapshot of a moving
        metagame. A Pokémon no sample team uses is not necessarily bad, only unusual.
      </p>
      <div class="table-scroll">
        <table class="meta-table">
          <thead><tr><th>Model</th><th class="r">Meta score</th><th class="r">Sample-team slots</th><th>Own picks no sample team uses</th><th>Fallbacks (not its picks)</th></tr></thead>
          <tbody>
            {byMeta.map((d) => (
              <tr>
                <td><a href={`/models/${d.config_id}/`}>{d.display_name}</a></td>
                <td class="r num"><strong>{d.meta.used}</strong><span class="muted">/{d.meta.of}</span></td>
                <td class="r num">{d.meta.slots}</td>
                <td class="small">{d.members.filter((m) => !m.fallback && !m.smogon_teams).map((m) => m.species).join(', ') || <span class="muted">none</span>}</td>
                <td class="small muted">{d.members.filter((m) => m.fallback).map((m) => m.species).join(', ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {picks.length > 0 && (
    <>
      <h3>Most drafted Pokémon</h3>
      <ol class="picks">{picks.slice(0, 12).map(([s, n]) => <li><span>{s}</span><span class="num muted">{n} of {legal.length}</span></li>)}</ol>
    </>
  )}

  <h3>The teams</h3>
  {drafts.length ? drafts.map((d) => <DraftedTeam draft={d} heading={d.draft === 1} />) : <p class="muted">No model has drafted yet.</p>}
  </section>
  ))}

  <h2 id="reference-teams">Reference teams</h2>
  <p class="prose">
    For testing the harness, for the Gen 9 meta score and for benchmarks played with fixed teams, we use sample teams from Smogon's
    <a href="https://www.smogon.com/forums/threads/sv-ou-sample-teams-new-samples-added-post-spl-and-tera-blast-ban.3712513/">SV OU Sample Teams</a>
    thread, hosted by the OU Room and forum staff. Each was built by the player named below.
  </p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Team</th><th>Style</th><th>Built by</th><th></th></tr></thead>
      <tbody>
        {refs.map((t) => (
          <tr>
            <td>{t.title}</td><td class="muted">{t.archetype}</td><td>{t.builder}</td>
            <td><a href={t.url}>Team</a>{!t.legal && <span class="pill warn" title="As posted, lists alternatives Showdown cannot play">options</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small muted">The fixed-teams benchmark uses two older teams written by the AI assistant that set up the project; see the <a href={routes.faq}>FAQ</a>.</p>
</Base>

<style>
  .picks { padding-left: 1.4rem; max-width: 28rem; font-family: var(--font-body); }
  .picks li { padding: 0.15rem 0; }
  .picks li span:first-child { display: inline-block; min-width: 12rem; }
  td .pill { margin-left: 0.4rem; }
  .bench-jump { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; margin: 1.4rem 0 0; font: 600 0.9rem var(--font-display);
    letter-spacing: 0.06em; text-transform: uppercase; }
  .bench-section { margin-top: 2.2rem; }
  .bench-title { font-size: 2rem; margin-bottom: 0.2rem; }
</style>
