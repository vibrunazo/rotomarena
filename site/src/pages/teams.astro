---
import Base from '../layouts/Base.astro';
import DraftedTeam from '../components/DraftedTeam.astro';
import { allDrafts } from '../lib/data';
import { routes } from '../lib/routes';
import reference from '../data/reference_teams.json';

const drafts = (await allDrafts()).sort((a, b) => Number(b.legal) - Number(a.legal) || a.attempts.length - b.attempts.length);
const legal = drafts.filter((d) => d.legal);
const picks = Object.entries(
  legal.flatMap((d) => d.members.map((m) => m.species)).reduce<Record<string, number>>((acc, s) => ((acc[s] = (acc[s] ?? 0) + 1), acc), {}),
).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const unanimous = picks.filter(([, n]) => legal.length > 1 && n === legal.length).map(([s]) => s);
// The meta score: how many of a team's Pokémon appear in at least one of Smogon's sample teams
const byMeta = [...drafts].filter((d) => d.meta.of > 0)
  .sort((a, b) => b.meta.used - a.meta.used || b.meta.slots - a.meta.slots || a.display_name.localeCompare(b.display_name));
const sampleTeams = drafts[0]?.meta.sample_teams ?? 0;
const refs = (reference.teams as { title: string; archetype: string; builder: string; url: string; legal: boolean }[]);
---
<Base title="Teambuilding" description="The teams language models built for themselves, and the validator that judged them.">
  <p class="eyebrow">Teambuilding</p>
  <h1>Teams</h1>
  <div class="prose">
    <p>
      Every model builds its own Gen 9 OverUsed team, in two steps. First it picks six Pokémon, given the rules of the
      format: the clauses, the banned abilities, moves and items, and the list of legal Pokémon. Then it gets the
      abilities and moves each of its six can legally have, and builds their sets. That is the same kind of help a
      player gets in a battle, where the legal moves are listed: rules, not strategy. It is not given usage
      statistics, sample teams or advice. What it builds is up to it.
    </p>
    <p>
      Each step is checked, the picks against the list and the finished team by Pokémon Showdown's validator, exactly
      as it checks a human player's. Anything illegal is sent back with the exact problems, and the model gets up to
      five attempts per step. A model that
      never gets there still plays: its last team is repaired by replacing only what the validator rejected, with
      deliberately unremarkable choices, so the mistake costs it something without costing it its place. Every
      attempt and every repair is published below.
    </p>
    {unanimous.length > 0 && (
      <p>
        So far, {legal.length === 2 ? 'both' : `all ${legal.length}`} models that built a legal team chose
        {' '}{unanimous.join(', ').replace(/, ([^,]*)$/, ' and $1')}. Whether this reflects the metagame or a shared memory of it
        is a question we have chosen not to investigate.
      </p>
    )}
  </div>

  {sampleTeams > 0 && byMeta.length > 0 && (
    <>
      <h2>Meta score</h2>
      <p class="prose">
        How many of each team's six Pokémon appear in at least one of Smogon's {sampleTeams} sample teams (listed under
        <a href="#reference-teams">Reference teams</a> below), and how many sample-team slots they fill between them.
        A rough yardstick: it judges the picks, not the sets, and the sample teams are one snapshot of a moving
        metagame. A Pokémon no sample team uses is not necessarily bad, only unusual.
      </p>
      <div class="table-scroll">
        <table class="meta-table">
          <thead><tr><th>Model</th><th class="r">Meta score</th><th class="r">Sample-team slots</th><th>Pokémon no sample team uses</th></tr></thead>
          <tbody>
            {byMeta.map((d) => (
              <tr>
                <td><a href={`/models/${d.config_id}/`}>{d.display_name}</a></td>
                <td class="r num"><strong>{d.meta.used}</strong><span class="muted">/{d.meta.of}</span></td>
                <td class="r num">{d.meta.slots}</td>
                <td class="small">{d.members.filter((m) => !m.smogon_teams).map((m) => m.species).join(', ') || <span class="muted">none</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {picks.length > 0 && (
    <>
      <h2>Most drafted Pokémon</h2>
      <ol class="picks">{picks.slice(0, 12).map(([s, n]) => <li><span>{s}</span><span class="num muted">{n} of {legal.length}</span></li>)}</ol>
    </>
  )}

  <h2>The teams</h2>
  {drafts.length ? drafts.map((d) => <DraftedTeam draft={d} heading />) : <p class="muted">No model has drafted yet.</p>}

  <h2 id="reference-teams">Reference teams</h2>
  <p class="prose">
    For testing the harness, and for benchmarks played with fixed teams, we use sample teams from Smogon's
    <a href="https://www.smogon.com/forums/threads/sv-ou-sample-teams-new-samples-added-post-spl-and-tera-blast-ban.3712513/">SV OU Sample Teams</a>
    thread, hosted by the OU Room and forum staff. Each was built by the player named below.
  </p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Team</th><th>Style</th><th>Built by</th><th></th></tr></thead>
      <tbody>
        {refs.map((t) => (
          <tr>
            <td>{t.title}</td><td class="muted">{t.archetype}</td><td>{t.builder}</td>
            <td><a href={t.url}>Team</a>{!t.legal && <span class="pill warn" title="As posted, lists alternatives Showdown cannot play">options</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small muted">The fixed-teams benchmark uses two older teams written by the AI assistant that set up the project; see the <a href={routes.faq}>FAQ</a>.</p>
</Base>

<style>
  .picks { padding-left: 1.4rem; max-width: 28rem; font-family: var(--font-body); }
  .picks li { padding: 0.15rem 0; }
  .picks li span:first-child { display: inline-block; min-width: 12rem; }
  td .pill { margin-left: 0.4rem; }
</style>
