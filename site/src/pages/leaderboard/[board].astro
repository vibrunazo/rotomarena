---
import LeaderboardBoard from '../../components/LeaderboardBoard.astro';
import { boards, mainBoard, type Board } from '../../lib/data';

export function getStaticPaths() {
  return boards.filter((b) => b.id !== mainBoard.id).map((board) => ({ params: { board: board.id }, props: { board } }));
}
const { board } = Astro.props as { board: Board };
---
<LeaderboardBoard board={board} />
