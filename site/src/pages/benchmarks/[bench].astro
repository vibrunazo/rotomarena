---
// One benchmark: its page is its current leaderboard (older versions are footnoted; see LeaderboardBoard).
import LeaderboardBoard from '../../components/LeaderboardBoard.astro';
import { benchBoards, benches, type Bench } from '../../lib/data';

export function getStaticPaths() {
  return benches.filter((b) => b.status === 'live' && b.main).map((bench) => ({ params: { bench: bench.id }, props: { bench } }));
}
const { bench } = Astro.props as { bench: Bench };
---
<LeaderboardBoard board={benchBoards(bench)[0]} />
